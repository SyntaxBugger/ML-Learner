# Server port (Render automatically provides PORT in production)
PORT=5000

# Python executable command or absolute path
# In Render (Linux production): python3
# In local development: python3 (macOS/Linux) or python / py (Windows)
PYTHON=python3

# Allowed frontend origin for CORS (no trailing slash)
# In production: https://your-frontend.vercel.app
# In local development: http://localhost:5173
FRONTEND_URL=http://localhost:5173

